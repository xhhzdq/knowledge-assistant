DATABASE_URL=postgresql+psycopg://knowledge_app:CHANGE_ME@127.0.0.1:5432/knowledge_assistant_dev
TEST_DATABASE_URL=postgresql+psycopg://knowledge_app:CHANGE_ME@127.0.0.1:5432/knowledge_assistant_test

# Docker Compose 中 PostgreSQL 容器的开发配置。
COMPOSE_BIND_ADDRESS=127.0.0.1
API_IMAGE=knowledge-assistant-api:week04
# Docker 构建阶段的 Python 包索引。本机可保留官方地址；网络受限服务器可改为可访问的镜像源。
PIP_INDEX_URL=https://pypi.org/simple
POSTGRES_IMAGE=postgres:17.6-alpine3.22
POSTGRES_USER=knowledge_app
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=knowledge_assistant_dev
POSTGRES_TEST_DB=knowledge_assistant_test
POSTGRES_PORT=5432

# MinIO 对象存储。真实密码只写入本地 .env，不提交到 Git。
DOCUMENT_STORAGE_BACKEND=local
MINIO_IMAGE=minio/minio:RELEASE.2025-09-07T16-13-09Z
MINIO_MC_IMAGE=minio/mc:RELEASE.2025-08-13T08-35-41Z
MINIO_ROOT_USER=knowledge_minio
MINIO_ROOT_PASSWORD=CHANGE_ME_TO_AT_LEAST_8_CHARACTERS
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ENDPOINT=http://127.0.0.1:9000
MINIO_ACCESS_KEY=knowledge_app
MINIO_SECRET_KEY=CHANGE_ME_TO_A_DEDICATED_APP_SECRET
MINIO_BUCKET=knowledge
MINIO_SECURE=false
MINIO_MAX_FILE_SIZE=10485760

# Redis 只保存缓存与临时状态，不作为文档元数据的唯一数据源。
REDIS_IMAGE=redis:7.4.11-alpine3.21
REDIS_PORT=6379
REDIS_PASSWORD=CHANGE_ME_TO_A_REDIS_PASSWORD
REDIS_URL=redis://:CHANGE_ME_TO_A_REDIS_PASSWORD@127.0.0.1:6379/0
DOCUMENT_CACHE_TTL_SECONDS=300
REDIS_CONNECT_TIMEOUT_SECONDS=1
REDIS_SOCKET_TIMEOUT_SECONDS=1

# 第四周文档处理。模型路径是容器内示例路径，不提交模型文件。
CHUNK_TARGET_CHARS=800
CHUNK_MAX_CHARS=1000
CHUNK_OVERLAP_CHARS=100

OCR_ENABLED=true
OCR_PROVIDER=paddle
OCR_DEVICE=cpu
OCR_MIN_TEXT_CHARS_PER_PAGE=20

EMBEDDING_PROVIDER=bge
EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
# 宿主机模型目录，通过只读挂载提供给 API 容器。
EMBEDDING_MODEL_HOST_PATH=./models/bge-small-zh-v1.5
EMBEDDING_MODEL_PATH=/models/bge-small-zh-v1.5
EMBEDDING_DIMENSION=512
EMBEDDING_BATCH_SIZE=16
EMBEDDING_DEVICE=cpu

# Milvus Standalone：服务端固定版本，复用现有 MinIO 的独立 Bucket。
ETCD_IMAGE=quay.io/coreos/etcd:v3.5.25
MILVUS_IMAGE=milvusdb/milvus:v2.6.22
MILVUS_PORT=19530
MILVUS_MINIO_BUCKET=milvus-data
# 本机 SDK/SSH 隧道使用此地址；Compose 中 API 会覆盖为 http://milvus:19530。
MILVUS_URI=http://127.0.0.1:19530
MILVUS_COLLECTION=document_chunks_v1
MILVUS_METRIC_TYPE=COSINE
MILVUS_TIMEOUT_SECONDS=5

API_PORT=8000
